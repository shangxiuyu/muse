amp(6.5px,1vw,16px);letter-spacing:.08em;padding-bottom:1.4vh}.p1 .ft{font-size:clamp(10px,1vw,16px);letter-spacing:0;line-height:1.2;padding-top:1.4vh;flex:none}.p1 .hd,.p1 .ft{width:70%}.p1 .hd span:last-child,.p1 .ft span:last-child{width:auto;padding-left:0;text-align:right;color:#EDF3E6}.p1 .body{max-width:65vw;padding:1vh 0}.p1 .lat{font-size:clamp(25px,7.4vw,124px);margin-bottom:2vh}.p1 .sub{margin-top:2vh;padding-top:1.5vh;line-height:1.55;max-width:38ch}.p2 .void .vhead,.p4 .vtest span{font-size:clamp(6.5px,1vw,16px)}</style>\n<div class=\"p1\">\n<div class=\"cut\" aria-hidden=\"true\"><i></i><b>留 下 的 部 分</b></div>\n<div class=\"hd\"><span>少一点，但好一点 · 品牌理念</span><span>01 / 06</span></div>\n<div class=\"body\">\n<div class=\"lat\">Less,<br>but better.</div>\n<div class=\"zh\">少一点，但好一点。</div>\n<div class=\"sub\">先问一件东西为什么要留下。<br>再决定，还需要增加什么。</div>\n</div>\n<div class=\"ft\"><span>Muse 原创概念样板</span><span>01 / 06</span></div>\n</div>"
    },
    {
      "title": "增加是默认动作，减少需要理由。",
      "body": "",
      "note": "这一页是整场提案的支点。左栏读给听众听，右侧整块留白不要填。\n\n本页目的：说清「多」的问题不在于多，而在于没人替它辩解过——每一次增加都有人签字，每一次删除都要有人承担风险。右侧那块空，就是「没人签字的东西」的位置。\n\n要避开的说法：不要讲成行业趋势或调研结论。这是问题假设，不是已开展的观察或调研。\n\n过渡：「既然减少需要理由，那我们的理由是什么？」\n\n【虚构概念示例。本页不含统计数字、用户访谈或市场结论。】",
      "kicker": "01 / 张力",
      "color": "#F2EFE3",
      "html": "<style>\n.p2{position:relative;box-sizing:border-box;width:100%;min-height:100vh;overflow:hidden;background:#F2EFE3;color:#132B1D;font-family:'PingFang SC','Noto Sans SC',-apple-system,sans-serif;display:flex;flex-direction:column;padding:5vh 5.2vw 4vh}\n.p2 *{box-sizing:border-box}\n.p2 .hd{display:flex;justify-content:space-between;align-items:baseline;gap:2vw;font-size:clamp(6.5px,.78vw,14px);letter-spacing:.16em;padding-bottom:1.6vh;border-bottom:1px solid rgba(19,43,29,.2);flex:none}\n.p2 .grid{flex:1 1 auto;min-height:0;display:grid;grid-template-columns:minmax(0,42%) minmax(0,1fr)}\n.p2 .lcol{padding:2vh 3.6vw 2vh 0;border-right:1px solid rgba(19,43,29,.2);display:flex;flex-direction:column;justify-content:center}\n.p2 .num{font-family:Georgia,serif;font-style:italic;font-size:clamp(11px,1.7vw,29px);color:#4E6B2E;line-height:1}\n.p2 h2{margin:1.8vh 0 2.8vh;font-family:'Songti SC','Noto Serif SC',Georgia,serif;font-weight:500;font-size:clamp(16px,3.3vw,56px);line-height:1.26;letter-spacing:.01em}\n.p2 p{margin:0 0 1.9vh;font-size:clamp(8px,1vw,17px);line-height:1.95;color:#3E5546;max-width:34ch}\n.p2 p:last-child{margin-bottom:0;color:#132B1D;font-family:'Songti SC',serif;font-size:clamp(9px,1.15vw,20px);line-height:1.8;letter-spacing:.03em}\n.p2 .void{padding:2vh 0 2vh 3.6vw;display:flex;flex-direction:column;justify-content:center;gap:2.6vh}\n.p2 .void .vhead{font-size:clamp(6.5px,.78vw,14px);letter-spacing:.22em;color:#93A389}\n.p2 .void .vtxt{font-family:'Songti SC','Noto Serif SC',Georgia,serif;font-weight:500;font-size:clamp(12px,1.9vw,33px);line-height:1.6;color:#A6B79B;letter-spacing:.06em;max-width:15ch}\n.p2 .vrule i{display:block;height:1px;background:rgba(19,43,29,.22);margin-bottom:1.5vh}\n.p2 .vrule i:last-child{margin-bottom:0;transform:scaleX(.42);transform-origin:left}\n.p2 hr{border:0;border-top:1px solid rgba(19,43,29,.2);margin:2.4vh 0 0;width:6vw}\n.p2 .ft{display:flex;justify-content:space-between;gap:2vw;font-size:clamp(6.5px,.78vw,14px);letter-spacing:.14em;padding-top:1.6vh;border-top:1px solid rgba(19,43,29,.2);flex:none}\n.p2{height:100vh;min-height:0;padding:4vh 5.2vw 3vh}.p2 .hd{font-size:clamp(6.5px,1vw,16px);letter-spacing:.08em;padding-bottom:1.4vh}.p2 .ft{font-size:clamp(10px,1vw,16px);letter-spacing:0;line-height:1.2;padding-top:1.4vh;flex:none}.p2 .grid{grid-template-columns:minmax(0,56%) minmax(0,1fr)}.p2 .lcol{padding:1vh 3vw 1vh 0}.p2 h2{font-size:clamp(15px,3.3vw,56px);margin:1.3vh 0 2vh}.p2 .num{font-size:clamp(9px,1.7vw,29px)}.p2 p{line-height:1.65;margin-bottom:1.8vh}.p2 p:last-child{line-height:1.5}.p2 .void{padding-left:4vw;gap:2vh}.p2 .void .vtxt{color:#5B6D50;font-size:clamp(10px,1.9vw,33px)}.p2 .void .vhead{color:#5B6D50}.p2 .void .vhead,.p4 .vtest span{font-size:clamp(6.5px,1vw,16px)}</style>\n<div class=\"p2\">\n<div class=\"hd\"><span>少一点，但好一点 · 品牌理念</span><span>02 / 06</span></div>\n<div class=\"grid\">\n<div class=\"lcol\">\n<span class=\"num\">i.</span>\n<h2>增加是默认动作，<br>减少需要理由。</h2>\n<p>每加一项功能，<br>都要分走一份注意力。</p>\n<p>先问用途，再决定保留。</p>\n</div>\n<div class=\"void\">\n<div class=\"vhead\">此 处 不 填</div>\n<div class=\"vtxt\">留着放那些还没有被删掉的东西。</div>\n<div class=\"vrule\" aria-hidden=\"true\"><i></i><i></i></div>\n<hr aria-hidden=\"true\">\n</div>\n</div>\n<div class=\"ft\"><span>概念假设 · 非调研结论</span><span>02 / 06</span></div>\n</div>"
    },
    {
      "title": "减少的是负担，不是功能。",
      "body": "",
      "note": "从浅底切回深底。切到这一页时把语速放慢。\n\n本页目的：把「少」的边界钉死——减的是负担，不是能力。如果听众听完得出「你们要砍功能」，那是这一页没讲完。\n\n要避开的说法：不要说「简单是一种奢侈」。这句话好听，但它什么都没承诺。\n\n过渡：「如果这条成立，它具体落在哪些动作上？」\n\n【虚构概念示例。】",
      "kicker": "02 / 主张",
      "color": "#0E2418",
      "html": "<style>\n.p3{position:relative;box-sizing:border-box;width:100%;min-height:100vh;overflow:hidden;background:#0E2418;color:#EDF3E6;font-family:'PingFang SC','Noto Sans SC',-apple-system,sans-serif;display:flex;flex-direction:column;padding:5vh 5.2vw 4vh}\n.p3 *{box-sizing:border-box}\n.p3 .wedge{position:absolute;right:-5.2vw;top:-5vh;bottom:-4vh;width:58%;background:#C9F04A;opacity:.15;clip-path:polygon(46% 0,100% 0,100% 100%,0 100%)}\n.p3 .line{position:absolute;right:0;top:0;bottom:0;width:58%;height:1px;background:#C9F04A;opacity:.45;top:52%}\n.p3 .hd{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:baseline;gap:2vw;font-size:clamp(6.5px,.78vw,14px);letter-spacing:.16em;padding-bottom:1.6vh;border-bottom:1px solid rgba(237,243,230,.22);flex:none}\n.p3 .body{position:relative;flex:1 1 auto;min-height:0;display:flex;flex-direction:column;justify-content:center;padding:2vh 0}\n.p3 .say{position:relative;z-index:2;max-width:62%}\n.p3 h2{margin:0;font-family:'Songti SC','Noto Serif SC',Georgia,serif;font-weight:500;font-size:clamp(17px,3.9vw,66px);line-height:1.24;letter-spacing:.01em}\n.p3 .lead{margin:3.2vh 0 0;font-size:clamp(8px,1vw,17px);line-height:1.95;color:#A9BCA5;max-width:36ch}\n.p3 .claim{margin-top:2.6vh;padding:1.8vh 0 1.8vh 1.6vw;border-left:2px solid #C9F04A;color:#EDF3E6;font-family:'Songti SC',serif;font-size:clamp(10px,1.2vw,21px);letter-spacing:.04em;line-height:1.7;max-width:34ch}\n.p3 .side{position:absolute;right:0;bottom:1vh;z-index:3;text-align:right;color:#C9F04A;font-family:'Songti SC',serif;font-weight:500;font-size:clamp(8px,1vw,18px);line-height:2.1;letter-spacing:.16em}\n.p3 .ft{position:relative;z-index:2;display:flex;justify-content:space-between;gap:2vw;font-size:clamp(6.5px,.78vw,14px);letter-spacing:.14em;padding-top:1.6vh;border-top:1px solid rgba(237,243,230,.22);flex:none}\n.p3{height:100vh;min-height:0;padding:4vh 5.2vw 3vh}.p3 .hd{font-size:clamp(6.5px,1vw,16px);letter-spacing:.08em;padding-bottom:1.4vh}.p3 .ft{font-size:clamp(10px,1vw,16px);letter-spacing:0;line-height:1.2;padding-top:1.4vh;flex:none}.p3 .body{padding:1vh 0}.p3 .lead{line-height:1.65;margin-top:2.5vh}.p3 .claim{margin-top:2.2vh;line-height:1.6}.p3 .line{display:none}.p2 .void .vhead,.p4 .vtest span{font-size:clamp(6.5px,1vw,16px)}</style>\n<div class=\"p3\">\n<div class=\"wedge\" aria-hidden=\"true\"></div>\n<div class=\"line\" aria-hidden=\"true\"></div>\n<div class=\"hd\"><span>少一点，但好一点 · 品牌理念</span><span>03 / 06</span></div>\n<div class=\"body\">\n<div class=\"say\">\n<h2>减少的是负担，<br>不是功能。</h2>\n<p class=\"lead\">让价值，在一次使用中被感到。</p>\n<div class=\"claim\">每次删减，先说清留下的价值。</div>\n</div>\n<div class=\"side\">负担 ─ 越来越少<br>手感 ─ 越来越厚</div>\n</div>\n<div class=\"ft\"><span>Muse 原创概念样板</span><span>03 / 06</span></div>\n</div>"
    },
    {
      "title": "三条原则，都得能被评审回答。",
      "body": "",
      "note": "不要逐条念。先念右上那条「讲不出怎么验，就删掉」，再回过头讲三条。\n\n本页目的：把理念变成评审会上能被追问的问题。每条原则后面跟一句「怎么验」，这样它才不是墙上的口号。\n\n要避开的说法：不要承诺百分比或时间。这三条是判断标准，不是指标。\n\n过渡：「说得再清楚，也不如拿一件东西试。」\n\n【虚构概念示例。原则本身不等同于已验证的产品结果。】",
      "kicker": "03 / 产品原则",
      "color": "#F2EFE3",
      "html": "<style>\n.p4{position:relative;box-sizing:border-box;width:100%;min-height:100vh;overflow:hidden;background:#F2EFE3;color:#132B1D;font-family:'PingFang SC','Noto Sans SC',-apple-system,sans-serif;display:flex;flex-direction:column;padding:5vh 5.2vw 4vh}\n.p4 *{box-sizing:border-box}\n.p4 .hd{display:flex;justify-content:space-between;align-items:baseline;gap:2vw;font-size:clamp(6.5px,.78vw,14px);letter-spacing:.16em;padding-bottom:1.6vh;border-bottom:1px solid rgba(19,43,29,.2);flex:none}\n.p4 .head{display:flex;justify-content:space-between;align-items:flex-end;gap:3vw;margin-top:3vh;flex:none}\n.p4 h2{margin:0;max-width:58%;font-family:'Songti SC','Noto Serif SC',Georgia,serif;font-weight:500;font-size:clamp(15px,2.9vw,50px);line-height:1.28;letter-spacing:.01em}\n.p4 .vtest{max-width:34%;text-align:right;padding-bottom:.4vh}\n.p4 .vtest span{display:block;font-size:clamp(6.5px,.78vw,14px);letter-spacing:.2em;color:#93A389;margin-bottom:1vh}\n.p4 .vtest b{font-family:'Songti SC','Noto Serif SC',Georgia,serif;font-weight:500;font-size:clamp(10px,1.3vw,23px);line-height:1.6;color:#4E6B2E;letter-spacing:.02em}\n.p4 .rows{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;justify-content:center;margin-top:2.2vh}\n.p4 .r{display:grid;grid-template-columns:minmax(0,5%) minmax(0,24%) minmax(0,1fr);gap:0 2.2vw;align-items:baseline;border-top:1px solid rgba(19,43,29,.2);padding:2.5vh 0}\n.p4 .r:last-child{border-bottom:1px solid rgba(19,43,29,.2)}\n.p4 .n{font-family:Georgia,serif;font-style:italic;font-size:clamp(11px,1.8vw,31px);color:#4E6B2E;line-height:1}\n.p4 .k{font-family:'Songti SC','Noto Serif SC',Georgia,serif;font-weight:500;font-size:clamp(12px,1.75vw,30px);letter-spacing:.06em;line-height:1.3;color:#132B1D}\n.p4 .v{font-size:clamp(8px,1vw,17px);line-height:1.9;color:#43594A;max-width:54ch}\n.p4 .ft{display:flex;justify-content:space-between;gap:2vw;font-size:clamp(6.5px,.78vw,14px);letter-spacing:.14em;padding-top:1.6vh;border-top:1px solid rgba(19,43,29,.2);flex:none}\n.p4{height:100vh;min-height:0;padding:4vh 5.2vw 3vh}.p4 .hd{font-size:clamp(6.5px,1vw,16px);letter-spacing:.08em;padding-bottom:1.4vh}.p4 .ft{font-size:clamp(10px,1vw,16px);letter-spacing:0;line-height:1.2;padding-top:1.4vh;flex:none}.p4 .head{margin-top:2vh}.p4 .r{padding:1.6vh 0;grid-template-columns:5% 23% minmax(0,1fr)}.p4 .v{line-height:1.55}.p4 .k{font-size:clamp(10px,1.75vw,30px)}.p4 .rows{margin-top:1.5vh}.p4 .vtest span{margin-bottom:.6vh;color:#556B47}.p4 .vtest b{font-size:clamp(9px,1.3vw,23px);line-height:1.4}.p2 .void .vhead,.p4 .vtest span{font-size:clamp(6.5px,1vw,16px)}</style>\n<div class=\"p4\">\n<div class=\"hd\"><span>少一点，但好一点 · 品牌理念</span><span>04 / 06</span></div>\n<div class=\"head\">\n<h2>三条原则，<br>都得能被评审回答。</h2>\n<div class=\"vtest\"><span>评 审 时 的 追 问</span><b>讲不出「怎么验」，<br>这一条就删掉。</b></div>\n</div>\n<div class=\"rows\">\n<div class=\"r\"><span class=\"n\">01</span><span class=\"k\">先答用途</span><span class=\"v\">解决什么问题？答不上来，就不进入下一稿。</span></div>\n<div class=\"r\"><span class=\"n\">02</span><span class=\"k\">手感优先</span><span class=\"v\">拿起、打开、收好，哪个动作变顺手了？</span></div>\n<div class=\"r\"><span class=\"n\">03</span><span class=\"k\">能被修</span><span class=\"v\">用旧之后能修好吗？说清可替换的部分。</span></div>\n</div>\n<div class=\"ft\"><span>评审原则 · 概念示例</span><span>04 / 06</span></div>\n</div>"
    },
    {
      "title": "从一只杯子开始。",
      "body": "",
      "note": "青柠绿在这里铺满左边近半页——全篇视觉重量在这一页封顶。\n\n本页目的：把三条原则压到一个具体物件上，让「留」和「放」都变成可以指出来的东西。左侧是要留的；右侧被划线划掉的，就是要放的。\n\n要避开的说法：不要展示实物，也不要声称已通过材料测试。杯子是设想，不是成品。\n\n过渡：「那下一步，我们只动一件事。」\n\n【虚构概念示例：杯型为构想说明，未经工艺与使用测试验证。】",
      "kicker": "04 / 落到实物",
      "color": "#0E2418",
