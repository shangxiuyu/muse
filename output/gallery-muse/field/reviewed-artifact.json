      "html": "<style>\n  .s5{position:relative;box-sizing:border-box;width:100%;aspect-ratio:16/9;min-height:100%;overflow:hidden;background:#EFE6D8;color:#2A2622;font-family:'PingFang SC','Noto Sans SC',-apple-system,sans-serif;padding:4.6vw 6vw 3.8vw;display:flex;flex-direction:column}\n  .s5 *{box-sizing:border-box}\n  .s5 .meta{display:flex;justify-content:space-between;gap:2vw;align-items:baseline;font-size:1vw;letter-spacing:.18em;color:#A08C74}\n  .s5 h2{margin:1.1vw 0 0;font-family:'Songti SC','Noto Serif SC',Georgia,serif;font-weight:600;font-size:3.8vw;line-height:1.25;letter-spacing:.01em}\n  .s5 .cols{flex:1;display:grid;grid-template-columns:.78fr 1.42fr;gap:3.6vw;margin-top:2.2vw;align-items:start}\n  .s5 .promise{background:#B8583C;color:#FFF6EC;padding:1.9vw 1.8vw;align-self:stretch;display:flex;flex-direction:column}\n  .s5 .promise small{font-size:.92vw;letter-spacing:.16em;color:rgba(255,244,232,.72)}\n  .s5 .promise b{display:block;margin:1.1vw 0 1.2vw;font-family:'Songti SC','Noto Serif SC',Georgia,serif;font-weight:600;font-size:2.5vw;line-height:1.3}\n  .s5 .promise ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:.85vw;font-size:1.08vw;line-height:1.6}\n  .s5 .promise li{padding-left:1.2vw;position:relative;color:#FBEADF}\n  .s5 .promise li::before{content:'·';position:absolute;left:0;color:rgba(255,244,232,.6)}\n  .s5 .method{display:flex;flex-direction:column;gap:0}\n  .s5 .mrow{display:grid;grid-template-columns:5.4vw 1fr;gap:1.4vw;padding:1.15vw 0;border-top:1px solid rgba(42,38,34,.16);align-items:baseline}\n  .s5 .mrow:last-child{border-bottom:1px solid rgba(42,38,34,.16)}\n  .s5 .mrow b{font-size:1vw;letter-spacing:.14em;color:#B8583C;font-weight:400;line-height:1.6}\n  .s5 .mrow h3{margin:0;font-size:1.35vw;font-weight:500;line-height:1.45}\n  .s5 .mrow p{margin:.35vw 0 0;font-size:1.05vw;line-height:1.65;color:#6E6255}\n  .s5 .foot{margin-top:1.6vw;padding-top:1.4vw;border-top:1px solid rgba(42,38,34,.16);display:flex;justify-content:space-between;gap:2vw;font-size:.98vw;letter-spacing:.1em;color:#8A7C6C;line-height:1.5}\n</style>\n<div class=\"s5\">\n  <div class=\"meta\"><span>留白 · ROOM TO THINK</span><span>04 / 试点</span></div>\n  <h2>先从一个团队、两周开始。</h2>\n  <div class=\"cols\">\n    <div class=\"promise\">\n      <small>我们承诺</small>\n      <b>不占用你<br>现有流程。</b>\n      <ul>\n        <li>不替换现有的沟通工具</li>\n        <li>不要求全员迁移</li>\n        <li>四周后若无人在用，即停止</li>\n      </ul>\n    </div>\n    <div class=\"method\">\n      <div class=\"mrow\"><b>第一周</b><div><h3>选一个正在进行的真实项目</h3><p>把背景、待办和当前状态整理进来，不改动团队的工作方式。</p></div></div>\n      <div class=\"mrow\"><b>第二周</b><div><h3>按原有节奏推进</h3><p>我们只记录卡住的地方：哪一步需要回头问人，哪一步找不到最新版。</p></div></div>\n      <div class=\"mrow\"><b>一起看</b><div><h3>用三个问题复盘</h3><p>交接是否更快？责任与下一步是否更清楚？团队是否愿意继续用？</p></div></div>\n      <div class=\"mrow\"><b>待确认</b><div><h3>成功标准与基线由团队共同定义</h3><p>试点在设计中，评估口径、阈值与时间窗尚未确定。</p></div></div>\n    </div>\n  </div>\n  <div class=\"foot\"><span>试点方案为概念示例 · 尚无用户数据</span><span>05 / 06</span></div>\n</div>"
    },
