      "html": "<style>\n  .s3{position:relative;box-sizing:border-box;width:100%;aspect-ratio:16/9;min-height:100%;overflow:hidden;background:#2C2A26;color:#F1E8DB;font-family:'PingFang SC','Noto Sans SC',-apple-system,sans-serif;padding:4.6vw 6vw 3.8vw;display:flex;flex-direction:column}\n  .s3 *{box-sizing:border-box}\n  .s3 .meta{display:flex;justify-content:space-between;gap:2vw;font-size:1vw;letter-spacing:.18em;color:#8E8271}\n  .s3 .body{flex:1;display:grid;grid-template-columns:1fr 1.05fr;gap:4.4vw;align-items:center;margin-top:1.6vw}\n  .s3 h2{margin:0;font-family:'Songti SC','Noto Serif SC',Georgia,serif;font-weight:600;font-size:4.5vw;line-height:1.3;letter-spacing:.01em}\n  .s3 h2 em{font-style:normal;color:#D97757}\n  .s3 .hole{margin-top:2.2vw;padding:1.5vw 1.6vw;background:#F4EDE2;color:#2A2622;display:inline-block}\n  .s3 .hole b{display:block;font-family:'Songti SC','Noto Serif SC',Georgia,serif;font-weight:600;font-size:1.9vw;line-height:1.4}\n  .s3 .hole span{display:block;margin-top:.5vw;font-size:1.08vw;line-height:1.65;color:#7A6C5C}\n  .s3 .list{display:flex;flex-direction:column;gap:1.9vw}\n  .s3 .li{display:grid;grid-template-columns:2.6vw 1fr;gap:1.5vw;align-items:start;padding-bottom:1.5vw;border-bottom:1px solid rgba(241,232,219,.16)}\n  .s3 .li:last-child{border-bottom:0;padding-bottom:0}\n  .s3 .li b{font-family:Georgia,serif;font-size:1.5vw;font-weight:400;color:#D97757;line-height:1.3}\n  .s3 .li h3{margin:0;font-size:1.62vw;font-weight:500;line-height:1.4}\n  .s3 .li p{margin:.42vw 0 0;font-size:1.1vw;line-height:1.68;color:#AEA293}\n  .s3 .foot{margin-top:1.4vw;padding-top:1.3vw;border-top:1px solid rgba(241,232,219,.16);display:flex;justify-content:space-between;gap:2vw;font-size:.98vw;letter-spacing:.1em;color:#8E8271}\n</style>\n<div class=\"s3\">\n  <div class=\"meta\"><span>留白 · ROOM TO THINK</span><span>02 / 方案</span></div>\n  <div class=\"body\">\n    <div>\n      <h2>所以，我们在一块纸上<br>挖了个<em>洞</em>。</h2>\n      <div class=\"hole\"><b>一件事，一个工作现场。</b><span>讨论、负责人、进度、交付物，收在同一个上下文里。</span></div>\n    </div>\n    <div class=\"list\">\n      <div class=\"li\"><b>01</b><div><h3>为什么做</h3><p>背景与已定的决策留在项目里，不在三个月后的聊天记录里。</p></div></div>\n      <div class=\"li\"><b>02</b><div><h3>谁来推进</h3><p>每个待办只有一个负责人。换人时责任跟着换，不悬空。</p></div></div>\n      <div class=\"li\"><b>03</b><div><h3>做到哪了</h3><p>状态与交付物在同一处更新，最新版就是唯一那版。</p></div></div>\n    </div>\n  </div>\n  <div class=\"foot\"><span>产品主张 · 虚构概念示例</span><span>03 / 06</span></div>\n</div>"
    },
