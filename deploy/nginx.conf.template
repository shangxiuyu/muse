# Replace muse.example.com and the certificate paths before installation.
# Install as a separate site; do not replace existing server blocks.
server {
    listen 80;
    server_name muse.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/muse-acme;
    }

    location / {
        return 301 https://muse.example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name muse.example.com;
    ssl_certificate /etc/letsencrypt/live/muse.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/muse.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Protect both static files and API routes, including event streams.
    auth_basic "Muse private workspace";
    auth_basic_user_file /etc/nginx/muse.htpasswd;
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Preserve the browser's Origin and Sec-Fetch-Site headers unchanged.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 360s;
        proxy_send_timeout 60s;
    }
}
