    {
      "id": "public-text-register-context",
      "kind": "system",
      "revision": 1,
      "data": {
        "title": "体裁决定作者与读者的关系",
        "status": "ready",
        "tags": [
          "text",
          "教学",
          "体裁",
          "语气"
        ],
        "media": [
          "text"
        ],
        "scope": "同一事实需要进入公告、客服、社交、报告或其他不同发布场景。",
        "intent": "让信息顺序、语气和节奏适合载体，同时保持事实一致。",
        "principles": [
          {
            "name": "先判断文字的工作和发布身份",
            "rule": "根据读者要完成的事决定进入方式、直接程度、段落结构和节奏，不把自然统一解释成口语或短句。",
            "rationale": "体裁改变作者与读者的关系，却不授权改变事实或补造承诺。",
            "applies_when": "相同素材需要跨渠道改写，或用户只说‘自然’但发布场景不同。",
            "avoid_when": "已有明确品牌规范或作者样本时，应在体裁边界内优先沿用它们。",
            "confidence": "provisional",
            "evidence": [
              {
                "reference_id": "public-text-register-context-reference",
                "reference_revision": 1,
                "observation_id": "comparison"
              }
            ]
          }
        ],
        "limits": [
          "原则来自原创教学对照，不提供每种体裁的固定模板。",
          "实际文本仍需结合受众、品牌和载体复读。"
        ]
      },
      "history": [],
      "updated_at": "2026-09-13T00:00:00.000Z"
    },
