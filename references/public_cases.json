    {
      "id": "public-text-evidence-bound",
      "kind": "system",
      "revision": 1,
      "data": {
        "title": "证据约束的具体表达",
        "status": "ready",
        "tags": [
          "text",
          "教学",
          "品牌文案",
          "证据"
        ],
        "media": [
          "text"
        ],
        "scope": "材料只有抽象收益，用户要求将品牌、产品或项目文案写得更具体。",
        "intent": "提高表达负载而不把合理猜测变成事实。",
        "principles": [
          {
            "name": "具体化先判断来源",
            "rule": "把新增细节标为来源、窄推导、占位或不安全；没有证据的功能、数字、经历和结果不得进入正式成稿。",
            "rationale": "具体细节增加可信感，也最容易让虚构内容被误认成真实承诺。",
            "applies_when": "产品、品牌、支持、研究或报告文案缺少机制和证据。",
            "avoid_when": "用户明确创作虚构故事或概念产品时可以生成细节，但需维持虚构边界。",
            "confidence": "provisional",
            "evidence": [
              {
                "reference_id": "public-text-evidence-bound-reference",
                "reference_revision": 1,
                "observation_id": "comparison"
              }
            ]
          }
        ],
        "limits": [
          "原则来自原创教学对照，不是特定品牌的写作规范。",
          "文案效果仍需在真实素材和发布场景中验证。"
        ]
      },
      "history": [],
      "updated_at": "2026-09-13T00:00:00.000Z"
    },
