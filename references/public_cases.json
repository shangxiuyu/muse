    {
      "id": "public-ui-brand-continuity",
      "kind": "system",
      "revision": 1,
      "data": {
        "title": "保留品牌，改善比较结构",
        "status": "ready",
        "tags": [
          "ui",
          "教学",
          "账单",
          "表格",
          "品牌"
