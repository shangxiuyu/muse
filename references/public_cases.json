    {
      "id": "public-ui-task-hierarchy",
      "kind": "system",
      "revision": 1,
      "data": {
        "title": "任务驱动的文字层级",
        "status": "ready",
        "tags": [
          "ui",
          "教学",
          "工作台",
          "层级"
        ],
        "media": [
          "web"
        ],
        "scope": "高频工作台：快速分辨任务标题、负责人和状态。",
        "intent": "让目标信息容易找到，保持紧凑但可读。",
        "principles": [
          {
            "name": "任务驱动的文字层级",
            "rule": "先分清标题、辅助信息和状态的任务角色，再用可感知的差异表达层级。",
            "rationale": "在高频搜索场景，扫描目标比均匀克制更有价值。",
            "applies_when": "密集工作台需要反复辨认任务与状态。",
            "avoid_when": "低密度说明页的细微层级已经足够时，不必扩大每个文本的反差。",
            "confidence": "provisional",
            "evidence": [
              {
                "reference_id": "public-ui-task-hierarchy-reference",
                "reference_revision": 1,
                "observation_id": "comparison"
              }
            ]
          }
        ],
        "limits": [
          "原则来自原创教学对照，是有条件的设计启发，不是经过用户验证的效果结论。",
          "没有固定组件、品牌色值或可直接套用的页面模板；需在实际内容和尺寸中验证。"
        ]
      },
      "history": [],
      "updated_at": "2026-09-13T00:00:00.000Z"
