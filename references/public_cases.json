    {
      "id": "public-text-voice-preservation",
      "kind": "system",
      "revision": 1,
      "data": {
        "title": "最小编辑与作者声音保护",
        "status": "ready",
        "tags": [
          "text",
          "教学",
          "声音",
          "改写"
        ],
        "media": [
          "text"
        ],
        "scope": "用户给出自己的草稿或样本，要求润色、去机械感或保持个人声音。",
        "intent": "提高可读性，同时让作者仍能认出自己的判断姿态和节奏。",
        "principles": [
          {
            "name": "先标出要保留的声音，再做最小有效编辑",
            "rule": "识别作者的直接程度、幽默、迟疑、岔开和段落节奏，只修改真正妨碍任务的部分。",
            "rationale": "统一的流畅和整齐会删除作者身份，而声音本身也是内容关系。",
            "applies_when": "有作者草稿、相近体裁样本或明确声音要求。",
            "avoid_when": "机构声明、法律文本或跨体裁写作需要改变发布身份时，应先服从责任和格式边界。",
            "confidence": "provisional",
            "evidence": [
              {
                "reference_id": "public-text-voice-preservation-reference",
                "reference_revision": 1,
                "observation_id": "comparison"
              }
            ]
          }
        ],
        "limits": [
          "原则来自原创教学对照，不证明任何特定改写更像真实作者。",
          "没有作者样本时只能形成当前任务的暂定声音，不能声称完成个人模仿。"
        ]
      },
      "history": [],
      "updated_at": "2026-09-13T00:00:00.000Z"
    },
