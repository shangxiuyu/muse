# Default: DeepSeek Flash for UI / decks / SVG images; V4 Pro for copywriting.
# Only this key is required. Keep your actual key in .env (never in web/).
DEEPSEEK_API_KEY=
# DeepSeek currently routes the legacy V4 Flash ID to V4.1 Flash.
# MUSE_FLASH_MODEL=deepseek-v4-flash
# MUSE_TEXT_MODEL=deepseek-v4-pro

# Optional compatible provider override; MUSE_MODEL overrides BOTH media routes.
# MUSE_API=openai-completions
# MUSE_BASE_URL=https://api.deepseek.com
# MUSE_MODEL=
# MUSE_API_KEY=
# MUSE_AUTH_TYPE=bearer
# MUSE_VISION=true
# MUSE_MAX_TOKENS=16000
# MUSE_CONTEXT_WINDOW=1000000
# MUSE_TIMEOUT_MS=300000
# MUSE_MAX_TURNS=24
# PORT=4173
# Optional VPS origin, behind an authenticated HTTPS reverse proxy.
# The backend still listens only on 127.0.0.1; preserve Host and Origin in the proxy.
# MUSE_PUBLIC_URL=https://muse.example.com
# MUSE_DATA_DIR=/absolute/path/to/private/muse-data
# Muse skill taste vault for local preference import; defaults to ~/Documents/Muse.
# MUSE_VAULT_DIR=/absolute/path/to/private/Muse
# MUSE_BROWSER_EXECUTABLE=/absolute/path/to/chrome

# Optional image generation/editing endpoint (OpenAI images protocol, b64_json output).
# Without this, the image medium supports AI-generated SVG illustrations.
# MUSE_IMAGE_BASE_URL=https://api.openai.com/v1
# MUSE_IMAGE_MODEL=
# MUSE_IMAGE_API_KEY=
